<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for NotifyIcon (tray icon + balloon notifications). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Windows-only app compile on the Linux build host. It must run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CertWatch</AssemblyName>
    <RootNamespace>CertWatch.App</RootNamespace>
    <!-- Needed by LibraryImport's generated P/Invoke stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used by TrayIcon.cs; keep its namespaces from clashing with WPF everywhere else. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\CertWatch.Core\CertWatch.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <!-- Ship the newest .NET 10 security patch in the self-contained build. The build host's SDK only
       knows an older patch; bump RuntimePatch with each .NET security release (releases.json). -->
  <PropertyGroup>
    <RuntimePatch>10.0.15</RuntimePatch>
  </PropertyGroup>
  <Target Name="PinRuntimeSecurityPatch" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownFrameworkReference Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net10.0' and ('%(KnownFrameworkReference.Identity)' == 'Microsoft.NETCore.App' or '%(KnownFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App' or '%(KnownFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App.WPF' or '%(KnownFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App.WindowsForms')">
        <LatestRuntimeFrameworkVersion>$(RuntimePatch)</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
    </ItemGroup>
  </Target>

</Project>
