<Window x:Class="CertWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CertWatch.App.Views"
        Title="CertWatch" MinWidth="560" MinHeight="480"
        Background="{StaticResource Ground}" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource Ink}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEF0F3" Padding="16,8,16,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="CertWatch" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="A tab appears for each browser that's running" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- One tab per browser. Header: verdict dot, browser name in its accent colour, current site. -->
            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Background="{StaticResource Ground}" BorderThickness="0,1,0,0" Padding="0"
                        Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Browsers">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,4,6,2" ToolTip="{Binding TabStatus}">
                            <Ellipse Width="10" Height="10" Fill="{Binding VerdictBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding AccentBrush}"/>
                                <TextBlock Text="{Binding TabStatus}" FontSize="11" Foreground="{StaticResource Muted}"
                                           MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <views:BrowserView/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock Margin="40" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="No supported browser is running. Open Edge, Chrome, Brave, Island, Vivaldi, Opera or Firefox and its tab appears here.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTabs}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
