<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared styles (DESIGN.md). Colours always come from the active theme via DynamicResource. -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- 24-unit stroke icons -->
    <Geometry x:Key="IconInspected">M5,11 H15 V19 H5 Z M7.5,11 V8.5 A2.5,2.5 0 0 1 12.5,8.5 V11 M17,4 A3,3 0 1 1 16.99,4 M19.2,9.2 L22,12</Geometry>
    <Geometry x:Key="IconSteered">M3,12 H7 C9,12 10,8 12,8 H21 M17,4 L21,8 L17,12</Geometry>
    <Geometry x:Key="IconDirect">M3,12 H21 M15,6 L21,12 L15,18</Geometry>
    <Geometry x:Key="IconUntrusted">M12,3 L22,20 H2 Z M12,10 V14 M12,17 V17.5</Geometry>
    <Geometry x:Key="IconNeutral">M12,3 A9,9 0 1 1 11.99,3</Geometry>
    <Geometry x:Key="IconBrowser">M12,3 A9,9 0 1 1 11.99,3 M3,12 H21 M12,3 C15,6 15,18 12,21 M12,3 C9,6 9,18 12,21</Geometry>
    <Geometry x:Key="IconSite">M4,5 H20 V19 H4 Z M4,9 H20</Geometry>

    <!-- Status visuals: bind the element's DataContext property "Status" (Inspected/Steered/Direct/Untrusted/Neutral). -->
    <Style x:Key="StatusTint" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NeutralTint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Inspected"><Setter Property="Background" Value="{DynamicResource InspectedTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Steered"><Setter Property="Background" Value="{DynamicResource SteeredTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Direct"><Setter Property="Background" Value="{DynamicResource DirectTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Untrusted"><Setter Property="Background" Value="{DynamicResource UntrustedTint}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource StatusTint}">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="5,1,6,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatusSolid" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Neutral}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Inspected"><Setter Property="Background" Value="{DynamicResource Inspected}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Steered"><Setter Property="Background" Value="{DynamicResource Steered}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Direct"><Setter Property="Background" Value="{DynamicResource Direct}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Untrusted"><Setter Property="Background" Value="{DynamicResource Untrusted}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource Neutral}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Inspected"><Setter Property="Fill" Value="{DynamicResource Inspected}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Steered"><Setter Property="Fill" Value="{DynamicResource Steered}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Direct"><Setter Property="Fill" Value="{DynamicResource Direct}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Untrusted"><Setter Property="Fill" Value="{DynamicResource Untrusted}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusInk" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnNeutralTint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Inspected"><Setter Property="Foreground" Value="{DynamicResource OnInspectedTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Steered"><Setter Property="Foreground" Value="{DynamicResource OnSteeredTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Direct"><Setter Property="Foreground" Value="{DynamicResource OnDirectTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Untrusted"><Setter Property="Foreground" Value="{DynamicResource OnUntrustedTint}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Status icon: the shape follows Status; colour comes from the setter on the instance (ink or white). -->
    <Style x:Key="StatusIcon" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource IconNeutral}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="2.2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{DynamicResource OnNeutralTint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Inspected"><Setter Property="Data" Value="{StaticResource IconInspected}"/><Setter Property="Stroke" Value="{DynamicResource OnInspectedTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Steered"><Setter Property="Data" Value="{StaticResource IconSteered}"/><Setter Property="Stroke" Value="{DynamicResource OnSteeredTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Direct"><Setter Property="Data" Value="{StaticResource IconDirect}"/><Setter Property="Stroke" Value="{DynamicResource OnDirectTint}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Untrusted"><Setter Property="Data" Value="{StaticResource IconUntrusted}"/><Setter Property="Stroke" Value="{DynamicResource OnUntrustedTint}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Path-diagram connector: bind LineStatus. -->
    <Style x:Key="Connector" TargetType="Rectangle">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Fill" Value="{DynamicResource Neutral}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LineStatus}" Value="Inspected"><Setter Property="Fill" Value="{DynamicResource Inspected}"/></DataTrigger>
            <DataTrigger Binding="{Binding LineStatus}" Value="Steered"><Setter Property="Fill" Value="{DynamicResource Steered}"/></DataTrigger>
            <DataTrigger Binding="{Binding LineStatus}" Value="Direct"><Setter Property="Fill" Value="{DynamicResource Direct}"/></DataTrigger>
            <DataTrigger Binding="{Binding LineStatus}" Value="Untrusted"><Setter Property="Fill" Value="{DynamicResource Untrusted}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ConnectorHead" TargetType="Path">
        <Setter Property="Data" Value="M0,0 L7,5 L0,10 Z"/>
        <Setter Property="Fill" Value="{DynamicResource Neutral}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LineStatus}" Value="Inspected"><Setter Property="Fill" Value="{DynamicResource Inspected}"/></DataTrigger>
            <DataTrigger Binding="{Binding LineStatus}" Value="Steered"><Setter Property="Fill" Value="{DynamicResource Steered}"/></DataTrigger>
            <DataTrigger Binding="{Binding LineStatus}" Value="Direct"><Setter Property="Fill" Value="{DynamicResource Direct}"/></DataTrigger>
            <DataTrigger Binding="{Binding LineStatus}" Value="Untrusted"><Setter Property="Fill" Value="{DynamicResource Untrusted}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Text -->
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Heading}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Buttons: 32px (28px with Tag="small"), 4px corners, 1px border -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnSurfaceMuted}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Heading}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryButton}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButton}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnBrand}"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource OnBrandMuted}"/>
    </Style>

    <!-- Tables: 30px rows, 1px dividers, header on SurfaceAlt, no zebra -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="ColumnHeaderHeight" Value="28"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource InspectedTint}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Browser tabs: 40px, 4px top corners; the selected tab merges into the content surface -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0" Padding="12,0" Height="40" Margin="0,0,2,-1">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
