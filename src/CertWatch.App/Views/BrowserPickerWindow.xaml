<Window x:Class="CertWatch.App.Views.BrowserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose browsers" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/CertWatch.ico"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- One selectable row per browser: the whole row toggles; several can be ticked before Apply. -->
        <Style x:Key="PickerRow" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1" Height="40" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                    <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{DynamicResource OnPrimaryButton}"
                                          StrokeThickness="2" Visibility="Collapsed" Margin="-1"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <Border x:Name="Chip" Grid.Column="2" CornerRadius="2" Padding="6,1" VerticalAlignment="Center"
                                        Background="{DynamicResource NeutralTint}">
                                    <TextBlock x:Name="ChipText" Text="Running" FontSize="11" Foreground="{DynamicResource OnNeutralTint}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                <Setter TargetName="Chip" Property="Background" Value="Transparent"/>
                                <Setter TargetName="ChipText" Property="Text" Value="Not running"/>
                                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryButton}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryButton}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Heading}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Choose browsers to monitor" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Heading}"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Tick as many as you like. CertWatch reads the address bar of these browsers only, and never sits in their traffic."/>

        <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="4" Padding="0,0,0,0" Background="{DynamicResource Surface}">
            <ItemsControl x:Name="List" ItemsSource="{Binding}" KeyboardNavigation.TabNavigation="Continue" Margin="0,0,0,-1"
                          AutomationProperties.Name="Browsers to monitor">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource PickerRow}" IsChecked="{Binding IsMonitored, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button Style="{StaticResource SmallButton}" Content="Select _all" Click="OnSelectAll"/>
            <Button Style="{StaticResource SmallButton}" Content="_Clear" Click="OnClear" Margin="6,0,0,0"/>
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                    Click="OnApply" Margin="8,0,0,0" MinWidth="96"/>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80"/>
        </DockPanel>
    </StackPanel>
</Window>
