<UserControl x:Class="CertWatch.App.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource OnSurface}">
    <!-- One browser tab (DESIGN.md): card (verdict, path, facts, notes) → sites → history. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HideWhenEmpty" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Status chip used in every table: icon + short text, tinted by Status. -->
        <DataTemplate x:Key="ChipCell">
            <Border Style="{StaticResource StatusChip}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource StatusIcon}" Width="11" Height="11" Margin="0,0,4,0" StrokeThickness="2.4"/>
                    <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Verdict}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>

    <!-- The page fills the window: Sites and History share the height left under the card, so there is
         no empty band at the bottom. Below MinHeight the whole page scrolls instead of squashing the tables. -->
    <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}">
        <Grid MinHeight="600" Height="{Binding ViewportHeight, ElementName=Page}">
        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="90"/>
            </Grid.RowDefinitions>

            <!-- Verdict card -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource StatusTint}" DataContext="{Binding Card}" CornerRadius="3,3,0,0" Padding="12,10"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource StatusSolid}" Width="40" Height="40" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource StatusIcon}" Stroke="{DynamicResource OnStatus}" Width="22" Height="22"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <!-- Saved result: Back to live takes Re-check's place, so the card keeps its size. -->
                                <Button Content="_Re-check" Command="{Binding RecheckCommand}" Margin="0,0,6,0"
                                        Visibility="{Binding ShowingLive, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="_Back to live" Command="{Binding BackToLiveCommand}" Margin="0,0,6,0"
                                        Visibility="{Binding ShowingSaved, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding CardNote}"/>
                                <Button Content="_Copy SHA-256" Command="{Binding CopyFingerprintCommand}" Margin="0,0,6,0"/>
                                <Button Content="_Export root" Command="{Binding ExportRootCommand}" Margin="0,0,6,0"
                                        ToolTip="Save this site's root certificate (.cer or .pem) or the full chain"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Context}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Subline}" FontSize="12" TextWrapping="Wrap" Opacity="0.9"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Path diagram: browser → tunnel/direct → inspection → site -->
                    <ItemsControl ItemsSource="{Binding Card.Path}" Margin="12,10" Focusable="False"
                                  AutomationProperties.Name="Path the traffic takes">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="5,4,10,4" Background="{DynamicResource Surface}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource StatusTint}" Width="24" Height="24" CornerRadius="4" Margin="0,0,8,0">
                                                <Path Data="{Binding Icon}" Style="{StaticResource StatusIcon}" Width="14" Height="14"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Label}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                                Visibility="{Binding HasArrow, Converter={StaticResource BoolToVis}}">
                                        <Rectangle Style="{StaticResource Connector}" Width="28"/>
                                        <Path Style="{StaticResource ConnectorHead}" Width="7" Height="10" Stretch="Fill"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Facts: 4 columns -->
                    <ItemsControl ItemsSource="{Binding Card.Facts}" Margin="12,0,12,8" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,16,4" ToolTip="{Binding ToolTipText}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Mono}" Value="True">
                                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Browser on its own path: offer to read the certificate viewer the user opens -->
                    <Button Style="{StaticResource SmallButton}" Content="{Binding ViewerButtonText}" Command="{Binding ToggleViewerCommand}" Margin="12,0,12,8"
                            Visibility="{Binding OfferViewer, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left"
                            ToolTip="Read the certificate viewer you open in this browser (read-only) and compare it with CertWatch's own connection"/>

                    <!-- Notes: browser on its own path, certificate viewer comparison, mTLS, earlier inspection -->
                    <ItemsControl ItemsSource="{Binding Card.Notes}" Margin="12,0,12,10" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusTint}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sites: each once -->
            <DockPanel Grid.Row="1" Margin="0,12,0,6" LastChildFill="False">
                <TextBlock Text="Sites" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding SiteCount}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Clear _browser…" Command="{Binding ClearBrowserCommand}" Margin="6,0,0,0"
                        ToolTip="Clear every site's history for this browser only"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Clear _site" Command="{Binding ClearSiteCommand}" Margin="6,0,0,0"
                        ToolTip="Clear the selected site's history for this browser"/>
                <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding SiteFilter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Filter sites" ToolTip="Filter sites by name"/>
                <TextBlock DockPanel.Dock="Right" Text="Filter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            </DockPanel>
            <Border Grid.Row="2" Background="{DynamicResource SteeredTint}" CornerRadius="4" Padding="8,4" Margin="0,0,0,6"
                    Tag="{Binding StatusMessage}" Style="{StaticResource HideWhenEmpty}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource OnSteeredTint}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding SitesView}" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                          AutomationProperties.Name="Sites seen in this browser">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Site" Binding="{Binding Host}" Width="2*" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="Now" Width="Auto" SortMemberPath="Verdict" CellTemplate="{StaticResource ChipCell}"/>
                        <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="2*"/>
                        <DataGridTextColumn Header="Egress" Binding="{Binding Egress}" Width="2*"/>
                        <DataGridTemplateColumn Header="Inspection" Width="2*" SortMemberPath="Inspection">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Inspection}" ToolTip="{Binding Inspection}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InspectionStatus}" Value="Inspected">
                                                        <Setter Property="Foreground" Value="{DynamicResource OnInspectedTint}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="Auto"/>
                        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="Auto"/>
                        <DataGridTextColumn Header="" Binding="{Binding MutualTls}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- History of the selected site: click an entry to show it on the card -->
            <TextBlock Grid.Row="4" Text="{Binding HistoryTitle}" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
            <Border Grid.Row="5" Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                          CanUserSortColumns="False" AutomationProperties.Name="History for the selected site">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Verdict" Width="Auto" CellTemplate="{StaticResource ChipCell}"/>
                        <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="2*"/>
                        <DataGridTextColumn Header="Egress" Binding="{Binding Egress}" Width="2*"/>
                        <DataGridTextColumn Header="" Binding="{Binding MutualTls}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
