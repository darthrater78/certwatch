<UserControl x:Class="CertWatch.App.Views.DockedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource OnSurface}">
    <!-- Side dock (DESIGN.md "Docked layouts"): the selected browser's card, stacked for a 380px panel,
         then the sites it visited. DataContext: BrowserTabViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="HideWhenEmpty" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="90"/>
        </Grid.RowDefinitions>

        <!-- Verdict card -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <Border Style="{StaticResource StatusTint}" DataContext="{Binding Card}" CornerRadius="3,3,0,0" Padding="12,10"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource StatusSolid}" Width="40" Height="40" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Style="{StaticResource StatusIcon}" Stroke="{DynamicResource OnStatus}" Width="22" Height="22"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Context}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Subline}" FontSize="11" TextWrapping="Wrap" Opacity="0.9"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Path: the nodes wrap onto a second line in the narrow panel -->
                <ItemsControl ItemsSource="{Binding Card.Path}" Margin="12,8" Focusable="False"
                              AutomationProperties.Name="Path the traffic takes">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="4,3,8,3" Background="{DynamicResource Surface}"
                                        ToolTip="{Binding Sub}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StatusTint}" Width="20" Height="20" CornerRadius="4" Margin="0,0,6,0">
                                            <Path Data="{Binding Icon}" Style="{StaticResource StatusIcon}" Width="12" Height="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0"
                                            Visibility="{Binding HasArrow, Converter={StaticResource BoolToVis}}">
                                    <Rectangle Style="{StaticResource Connector}" Width="14"/>
                                    <Path Style="{StaticResource ConnectorHead}" Width="6" Height="9" Stretch="Fill"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Facts: 2 columns -->
                <ItemsControl ItemsSource="{Binding Card.Facts}" Margin="12,0,12,6" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,12,4" ToolTip="{Binding ToolTipText}">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mono}" Value="True">
                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Card.Notes}" Margin="12,0,12,8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusTint}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Margin="12,0,12,10">
                    <Button Style="{StaticResource SmallButton}" Content="_Re-check" Command="{Binding RecheckCommand}" Margin="0,0,6,0"
                            Visibility="{Binding ShowingLive, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="10,0" Content="_Back to live" Command="{Binding BackToLiveCommand}" Margin="0,0,6,0"
                            Visibility="{Binding ShowingSaved, Converter={StaticResource BoolToVis}}" ToolTip="{Binding CardNote}"/>
                    <Button Style="{StaticResource SmallButton}" Content="_Copy SHA-256" Command="{Binding CopyFingerprintCommand}"/>
                <Button Style="{StaticResource SmallButton}" Content="{Binding ViewerButtonText}" Command="{Binding ToggleViewerCommand}" Margin="0,6,0,0"
                        Visibility="{Binding OfferViewer, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left"
                        ToolTip="Read the certificate viewer you open in this browser (read-only) and compare it with CertWatch's own connection"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SteeredTint}" CornerRadius="4" Padding="8,4" Margin="0,8,0,0"
                Tag="{Binding StatusMessage}" Style="{StaticResource HideWhenEmpty}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource OnSteeredTint}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="2" Text="Sites" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" HorizontalAlignment="Left"/>
        <!-- Most recent first; click one to show its saved result on the card -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding SitesView}" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                      HeadersVisibility="None" AutomationProperties.Name="Sites seen in this browser">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Host}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource StatusIcon}" Width="11" Height="11" Margin="0,0,4,0" StrokeThickness="2.4"/>
                                        <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Verdict}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding LastSeenTime}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
