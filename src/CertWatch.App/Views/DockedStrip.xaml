<UserControl x:Class="CertWatch.App.Views.DockedStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource OnSurface}">
    <!-- Top dock (DESIGN.md "Docked layouts"): one 64px row, tinted by the verdict. Status tile, verdict,
         path, then as many facts as fit. DataContext: BrowserTabViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource StatusTint}" DataContext="{Binding Card}">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MaxWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusSolid}" Width="40" Height="40" CornerRadius="4" VerticalAlignment="Center">
                <Path Style="{StaticResource StatusIcon}" Stroke="{DynamicResource OnStatus}" Width="22" Height="22"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0" ToolTip="{Binding Subline}">
                <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Context}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource StatusInk}" Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Path, as titles joined by status-coloured connectors -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Path}" VerticalAlignment="Center" Focusable="False" Margin="0,0,16,0"
                          AutomationProperties.Name="Path the traffic takes">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Sub}">
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Style="{StaticResource StatusInk}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                                        Visibility="{Binding HasArrow, Converter={StaticResource BoolToVis}}">
                                <Rectangle Style="{StaticResource Connector}" Width="16"/>
                                <Path Style="{StaticResource ConnectorHead}" Width="5" Height="8" Stretch="Fill"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Facts in card order (issuer, root, …); the row clips whatever doesn't fit -->
            <ItemsControl Grid.Column="3" ItemsSource="{Binding Facts}" VerticalAlignment="Center" Focusable="False" ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,20,0" MaxWidth="220" ToolTip="{Binding ToolTipText}">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurface}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mono}" Value="True">
                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Center"
                    Content="_Back to live" Command="{Binding DataContext.BackToLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="{Binding DataContext.CardNote, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding DataContext.ShowingSaved, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
