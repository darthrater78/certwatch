<Window x:Class="CertWatch.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CertWatch log" Width="980" Height="560" MinWidth="560" MinHeight="300" Icon="../Assets/CertWatch.ico"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <CheckBox x:Name="DebugBox" Content="_Debug detail" Margin="0,0,16,0" Click="OnDebug"
                          ToolTip="Also log address-bar reads, routes, issuers and DevTools traffic"/>
                <CheckBox x:Name="FileBox" Content="Write log to _file" Margin="0,0,16,0" Click="OnFile"
                          ToolTip="Append the log to %LOCALAPPDATA%\CertWatch\logs. Entries name the sites you visit; off by default."/>
                <TextBlock Text="Filter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="FilterBox" Width="200" TextChanged="OnFilter" AutomationProperties.Name="Filter log entries"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="C_lear log" Click="OnClear" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="_Copy all" Click="OnCopy" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="_Open log folder" Click="OnOpenFolder" Margin="6,0,0,0"/>
            </DockPanel>
        </Border>
        <DataGrid x:Name="Grid" ItemsSource="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" RowHeight="24"
                  EnableRowVirtualization="True" AutomationProperties.Name="Log entries">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="Auto"/>
                <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="Auto"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
