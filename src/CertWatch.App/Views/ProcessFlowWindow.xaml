<Window x:Class="CertWatch.App.Views.ProcessFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CertWatch process flow" Width="1280" Height="760" MinWidth="1040" MinHeight="520" Icon="../Assets/CertWatch.ico"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <DataTemplate x:Key="PinCell">
            <Border DataContext="{Binding Pin}" Style="{StaticResource StatusChip}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource StatusInk}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ResultCell">
            <Border Style="{StaticResource StatusChip}">
                <TextBlock Text="{Binding Chip}" Style="{StaticResource StatusInk}" FontSize="11"/>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Content="_Start" Click="OnStartStop" MinWidth="84" Margin="8,0,0,0"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="AllNamedBox" Content="All processes of this _name" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="Browsers and many apps use several processes, and the network one is often not the one with the window"/>
                    <Button DockPanel.Dock="Right" x:Name="AddButton" Content="_Add" Click="OnAddName" Margin="6,0,0,0"/>
                    <TextBox DockPanel.Dock="Right" x:Name="NameBox" Width="170" Height="32" MaxLength="140" VerticalContentAlignment="Center" KeyDown="OnNameKey"
                             ToolTip="Type a process name, such as java or app.exe. It doesn't need to be running yet."
                             AutomationProperties.Name="Process name to add"/>
                    <TextBlock DockPanel.Dock="Right" Text="or add by name" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBlock Text="Process" Style="{StaticResource SectionTitle}" Margin="0,0,10,0"/>
                    <Button x:Name="ProcessButton" Content="Choose a process…" HorizontalContentAlignment="Left" Click="OnChooseProcess"
                            ToolTip="Lists processes with open connections, refreshed each time it opens" AutomationProperties.Name="Process to follow"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <CheckBox x:Name="CaptureBox" Content="Read this process's _handshakes (needed to detect pinning)" Click="OnCapture" VerticalAlignment="Center" Margin="0,0,12,0"
                              AutomationProperties.Name="Read this process's TLS handshakes"/>
                    <TextBlock x:Name="CaptureHint" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="C_lear list" Click="OnClearList" Margin="6,0,0,0"
                            ToolTip="Empty the results and their accepted and refused counts. Connections still open reappear."/>
                    <CheckBox DockPanel.Dock="Right" x:Name="OpenOnlyBox" Content="_Open only" Click="OnFilterChanged" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox DockPanel.Dock="Right" x:Name="SearchBox" Width="150" Height="28" VerticalContentAlignment="Center" TextChanged="OnSearch"
                             ToolTip="Filter by process, host, address or issuer" AutomationProperties.Name="Filter destinations"/>
                    <TextBlock DockPanel.Dock="Right" Text="Filter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShowAll" Style="{StaticResource SmallButton}" Click="OnGroupFilter" Margin="0,0,4,0"/>
                        <Button x:Name="ShowAttention" Style="{StaticResource SmallButton}" Click="OnGroupFilter" Margin="0,0,4,0"/>
                        <Button x:Name="ShowCantTell" Style="{StaticResource SmallButton}" Click="OnGroupFilter" Margin="0,0,4,0"/>
                        <Button x:Name="ShowNoSign" Style="{StaticResource SmallButton}" Click="OnGroupFilter"/>
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <DataGrid x:Name="Flows" SelectionChanged="OnSelected" AutomationProperties.Name="Where the process connects">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ProcessColumn" Header="Process" Binding="{Binding Owner}" Width="Auto" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Destination" Binding="{Binding Host}" Width="3*" FontWeight="SemiBold"/>
                                <DataGridTemplateColumn Header="Pinned?" Width="Auto" SortMemberPath="Group" CellTemplate="{StaticResource PinCell}"/>
                                <DataGridTemplateColumn Header="Inspection" Width="Auto" SortMemberPath="Chip" CellTemplate="{StaticResource ResultCell}"/>
                                <DataGridTextColumn Header="TLS" Binding="{Binding Tls}" Width="Auto"/>
                                <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="2*"/>
                                <DataGridTextColumn Header="Open" Binding="{Binding Open}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   Text="Choose a process and press Start."/>
                    </Grid>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock x:Name="NoSelection" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                               Text="Select a destination to see whether it's pinned and what to do next."/>
                    <ScrollViewer x:Name="Detail" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border DataContext="{Binding Pin}" Style="{StaticResource StatusTint}" Padding="12" CornerRadius="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Is it pinned?" Style="{StaticResource StatusInk}" FontSize="11"/>
                                    <TextBlock Text="{Binding Headline}" Style="{StaticResource StatusInk}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource StatusInk}" TextWrapping="Wrap"/>
                                    <TextBlock Text="What to do next" Style="{StaticResource StatusInk}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding Next}" Style="{StaticResource StatusInk}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="12">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="_Copy details" Click="OnCopy"/>
                                    <TextBlock Text="{Binding Host}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FactLabel}" Text="Process response"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Reaction, TargetNullValue='', FallbackValue=''}"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FactLabel}" Text="Inspection"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Chip}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FactLabel}" Text="Name from"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding HostSource}"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FactLabel}" Text="Address"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Remote}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    <TextBlock Grid.Row="4" Style="{StaticResource FactLabel}" Text="TLS"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Tls}"/>
                                    <TextBlock Grid.Row="5" Style="{StaticResource FactLabel}" Text="Egress"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding PathText}"/>
                                </Grid>
                                <TextBlock Text="Certificate flow" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
                                <ItemsControl ItemsSource="{Binding Nodes}" AutomationProperties.Name="Certificate flow steps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Rectangle Width="2" Height="10" HorizontalAlignment="Left" Margin="16,0,0,0" Fill="{DynamicResource LineStrong}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Role}" Style="{StaticResource Label}"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
